# /etc/default/garb
# Configuration file for Galera Arbitrator Service (garb)

# Node name for the arbitrator
GALERA_NAME="nlcl01garbd01"

# Galera cluster name
GALERA_GROUP="eu-nl-mariadb01"

# A space-separated list of node addresses in the cluster
GALERA_NODES="10.0.X.X:4567 10.0.X.X:4567 10.0.X.X:4567"

# Log file for garbd (optional, defaults to syslog if not set)
LOG_FILE="/var/log/garbd/garbd.log"

# Galera Arbitrator options, such as SSL settings
#GALERA_OPTIONS="socket.ssl_key=/etc/ssl/garbd/gmnode.key;socket.ssl_cert=/etc/ssl/garbd/gmnode.pem;socket.ssl_ca=/etc/ssl/garbd/gmca.pem"
